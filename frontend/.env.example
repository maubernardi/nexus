# Modalità di autenticazione: "mock" (header X-USER-ID, backend con profilo local) o "keycloak"
VITE_AUTH_MODE=mock
# Solo per VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=nexus
VITE_KEYCLOAK_CLIENT_ID=nexus-frontend
# Base URL API (default: /api/v1 tramite proxy Vite)
VITE_API_BASE_URL=/api/v1
