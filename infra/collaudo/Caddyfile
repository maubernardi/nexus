# NEXUS — collaudo sul PC del PO (EN-11): al posto di frontend/Caddyfile nell'immagine nexus-web costruita per il
# collaudo. Stesse regole della produzione (solo /api verso il backend, endpoint tecnici nascosti, cache, accesso degli
# amministratori di Keycloak bloccato), ma in HTTP su localhost: niente certificati, niente HSTS, niente www.
# Se cambi le regole di frontend/Caddyfile, cambiale anche qui.
{
	admin off
	auto_https off
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}
}

# NEXUS: PWA e API, come https://portalenexus.it
:8090 {
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:8091; frame-src http://localhost:8091; worker-src 'self'; manifest-src 'self'; form-action 'self' http://localhost:8091; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	encode zstd gzip

	@internal path /actuator /actuator/* /v3/api-docs /v3/api-docs/* /swagger-ui /swagger-ui/* /swagger-ui.html
	handle @internal {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Keycloak, come https://auth.portalenexus.it. La console è su http://localhost:8092/admin (compose del collaudo)
:8091 {
	import security_headers
	@admin path /admin /admin/* /realms/master /realms/master/*
	respond @admin "Accesso non consentito" 403
	reverse_proxy keycloak:8080
}
