{
  "permissions": {
    "deny": [
      "Bash(git merge *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh",
            "statusMessage": "Verifica regole git (merge / push su main)"
          }
        ]
      }
    ]
  }
}
